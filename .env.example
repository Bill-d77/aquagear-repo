# Database
DATABASE_URL="postgresql://..."

# Auth
AUTH_SECRET="your_auth_secret"

# UploadThing
UPLOADTHING_TOKEN="your_uploadthing_token"

# Telegram order notifications (server-only; optional — if unset, notifications are skipped)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Consent-gated analytics/marketing (public; optional — scripts stay inert until set)
NEXT_PUBLIC_GA_ID=""          # e.g. G-XXXXXXXXXX (Google Analytics 4 / Google Ads via gtag)
NEXT_PUBLIC_META_PIXEL_ID=""  # e.g. 1234567890 (Meta Pixel)

# Explicit admin bootstrap. Required only when running npm run seed.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace_with_a_strong_password"
SEED_ADMIN_NAME="Admin"

# Meta — WhatsApp Cloud API + Instagram DMs → unified orders (server-only; optional —
# the inbox stays empty until set). Setup: docs/meta-integration.md
META_VERIFY_TOKEN=""          # any long random string; paste the same value into the Meta webhook settings
META_APP_SECRET=""            # App Dashboard → App settings → Basic → App secret (signs WhatsApp webhooks)
INSTAGRAM_APP_SECRET=""       # App Dashboard → Instagram → API setup with Instagram login → Instagram app secret
META_GRAPH_API_VERSION="v26.0"
WHATSAPP_PHONE_NUMBER_ID=""   # WhatsApp → API Setup → Phone number ID
WHATSAPP_ACCESS_TOKEN=""      # System-user token with whatsapp_business_messaging (+ _management)
INSTAGRAM_ACCOUNT_ID=""       # Instagram professional account ID (optional; defaults to "me")
INSTAGRAM_ACCESS_TOKEN=""     # Long-lived Instagram user token; refreshed automatically by the daily cron
META_EVENT_RETENTION_DAYS="30" # raw webhook payloads are pruned after this many days
CRON_SECRET=""                # Vercel Cron sends it as a Bearer token to /api/cron/meta
