generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  role       String   @default("USER")
  createdAt  DateTime @default(now())
  /// APNs device tokens of this user's admin-app installs (admins only).
  pushTokens String[] @default([])
  orders     Order[]
  reviews    Review[]
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String
  price       Int
  imageUrl    String         @default("")
  stock       Int            @default(0)
  isArchived  Boolean        @default(false)
  category    Category       @relation(fields: [categoryId], references: [id])
  categoryId  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  reviews     Review[]
  orderItems  OrderItem[]
  images      ProductImage[]
  // Extra phrases customers use for this product in DMs ("black mask"), matched
  // by the Meta order extractor before fuzzy name matching.
  aliases     String[]       @default([])

  // Google Merchant Center identifiers (optional; admin-entered). When brand +
  // gtin/mpn are absent the feed marks identifier_exists=no, which Google allows.
  brand                 String?
  gtin                  String?
  mpn                   String?
  condition             String  @default("new") // new | refurbished | used
  googleProductCategory String?
}

model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, order])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
}

model Order {
  id               String      @id @default(cuid())
  user             User?       @relation(fields: [userId], references: [id])
  userId           String?
  items            OrderItem[]
  total            Int
  status           String      @default("PENDING")
  name             String?
  location         String?
  phoneNumber      String?
  apartment        String?
  paymentMode      String      @default("COD")
  createdAt        DateTime    @default(now())
  // Fulfillment metadata (admin phase 2)
  notes            String?
  placedAt         DateTime?
  shippedAt        DateTime?
  canceledAt       DateTime?
  trackingNumber   String?
  carrier          String?
  lastContactedAt  DateTime?
  // WEBSITE | APP | WHATSAPP | INSTAGRAM
  source           String        @default("WEBSITE")
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversationId   String?
  // Snapshot of the extractor output that created/last updated this draft.
  extraction       Json?
  audits           OrderAudit[]

  @@index([source])
  @@index([conversationId])
  @@index([status, createdAt])
}

// Append-only history of who changed what on an order (admin edits, Meta
// draft creation, confirmations, status changes).
model OrderAudit {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  actor     String // admin email, or "system"
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// One thread per customer per channel — WhatsApp and Instagram both model a DM
// as a single ongoing thread between the business and the customer.
model Conversation {
  id             String    @id @default(cuid())
  channel        String // WHATSAPP | INSTAGRAM
  externalUserId String // WhatsApp wa_id, or Instagram-scoped user id (IGSID)
  name           String?
  username       String?
  phone          String?
  // OPEN | WAITING_FOR_ADMIN | WAITING_FOR_CUSTOMER | POTENTIAL_ORDER |
  // ORDER_DETECTED | ORDER_CONFIRMED | CLOSED
  status         String    @default("OPEN")
  unreadCount    Int       @default(0)
  lastMessageAt  DateTime  @default(now())
  lastInboundAt  DateTime?
  lastReadAt     DateTime?
  // Latest extractor output, kept even when it isn't confident enough for a draft.
  extraction     Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messages       Message[]
  orders         Order[]

  @@unique([channel, externalUserId])
  @@index([lastMessageAt])
}

model Message {
  id                String       @id @default(cuid())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId    String
  // wamid.* / Instagram mid — globally unique, so webhook retries can't duplicate.
  externalMessageId String       @unique
  direction         String // INBOUND | OUTBOUND
  type              String // TEXT | IMAGE | VIDEO | AUDIO | DOCUMENT | LOCATION | INTERACTIVE | REACTION | UNKNOWN
  text              String?
  // Media ids/urls, location, reply context. Never the media bytes.
  metadata          Json?
  // Delivery state for outbound messages: sent | delivered | read | failed
  status            String?
  sentBy            String? // admin email for dashboard replies
  externalTimestamp DateTime
  createdAt         DateTime     @default(now())

  @@index([conversationId, externalTimestamp])
}

// Raw signed webhook deliveries, kept for audit/debugging and retried on failure.
// eventKey = sha256 of the raw body, so Meta's retries of the same delivery dedupe.
model MetaWebhookEvent {
  id          String    @id @default(cuid())
  eventKey    String    @unique
  channel     String // WHATSAPP | INSTAGRAM | UNKNOWN
  eventType   String
  payload     Json
  // RECEIVED | PROCESSING | PROCESSED | IGNORED | FAILED
  status      String    @default("RECEIVED")
  error       String?
  retryCount  Int       @default(0)
  nextRetryAt DateTime?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([status, nextRetryAt])
  @@index([receivedAt])
}

// Server-side Meta credentials that rotate at runtime (the Instagram user token
// is refreshed every few weeks). Values are AES-GCM encrypted with AUTH_SECRET.
model MetaCredential {
  key       String   @id
  value     String
  seedHash  String // sha256 of the env token this was refreshed from
  expiresAt DateTime?
  updatedAt DateTime @updatedAt
}

model StoreSettings {
  id               String   @id @default("singleton")
  storeName        String   @default("AquaGear")
  whatsappNumber   String   @default("96171634379")
  shippingFlatRate Int      @default(400) // cents; the delivery fee charged at checkout (0 = free shipping)
  businessHours    String   @default("Mon-Sat 9:00-18:00")
  updatedAt        DateTime @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Int
}

model Review {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  // One review per customer per product — updating replaces the old one.
  @@unique([userId, productId])
}

// Immutable audit trail of cookie-consent decisions (GDPR/ePrivacy Art. 7(1)).
// One row per accept/reject/change; never updated or deleted. userId is optional
// so guest consents are logged against the anonymous browser id.
// First-party pageview log. Rows are written only for visitors whose analytics
// consent is granted (checked server-side), and auto-pruned after 90 days.
model PageView {
  id        String   @id @default(cuid())
  anonId    String?
  path      String
  country   String?
  device    String? // desktop | mobile | tablet
  browser   String? // coarse family
  os        String? // coarse family (iOS, Android, Windows, macOS, Linux)
  referrer  String? // external host only
  // Campaign attribution, captured from the landing URL's utm_* params.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

model CookieConsent {
  id         String   @id @default(cuid())
  anonId     String
  userId     String?
  version    Int
  functional Boolean
  analytics  Boolean
  marketing  Boolean
  country    String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([anonId])
  @@index([createdAt])
}
